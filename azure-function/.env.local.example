# For bootstrap-state.mjs only (plain KEY=VALUE, read via `node --env-file`).
# Copy to .env.local — gitignored, never commit real values.

# Reuse the value from ../.env.local (made by ../scripts/get-token.mjs),
# or run that script again to mint a fresh one.
AZURE_REFRESH_TOKEN=

# Azure Portal → your Storage Account (the one linked to the Function App)
# → Access keys → Connection string
STATE_STORAGE_CONNECTION_STRING=

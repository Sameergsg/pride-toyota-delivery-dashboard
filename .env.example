# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets.
# In CI/production these are supplied as GitHub Actions encrypted repo secrets
# (Settings → Secrets and variables → Actions), NOT via this file.
#
# See SETUP.md for how to obtain these values — the short version is:
#   1. Register a secret-less "public client" Azure AD app (no admin needed).
#   2. Run `node --env-file=.env.local scripts/get-token.mjs` once to sign in
#      interactively and mint AZURE_REFRESH_TOKEN below (also auto-written
#      here by that script).
#   3. Add all of these as GitHub Actions repo secrets too.

# Azure AD (Entra ID) public-client app registration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Delegated refresh token — minted by `node scripts/get-token.mjs` (one-time
# interactive sign-in). Rotates on every use; scripts/sync.mjs handles
# re-saving it, but only in CI (via GH_PAT below) — locally it rewrites this
# file directly.
AZURE_REFRESH_TOKEN=

# Only needed as a fallback if this tenant ever grants admin consent for an
# application (client-credentials) permission instead — see SETUP.md.
# AZURE_CLIENT_SECRET=

# Fine-grained GitHub PAT scoped to just this repo, "Secrets: read and
# write" permission — lets sync.mjs persist the rotated AZURE_REFRESH_TOKEN
# back into GitHub Actions secrets after each run. Only used in CI, not
# needed for local runs.
# GH_PAT=

# The SharePoint share link for the source Excel workbook
SHAREPOINT_SHARE_URL=https://goyalsonsautomobilespvtl083-my.sharepoint.com/:x:/g/personal/edp_bhiwani_pridetoyota_in/IQAvAwAiAz4pRov7U8X8MHJ4AdSoT8BgpL4iuZTg6SM3tpA?e=ameVTp
